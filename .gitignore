# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# answer-book figure gallery / wrap-measure output (regenerated per run)
/answer-book/tools/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
env.local*
# secrets stay out even when encrypted — a passphrase is one leak away from plaintext
*.gpg
*.asc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local claude settings (user-specific)
.claude/settings.local.json

# logs & ad-hoc debug output
*.log
ts.log
tsc_output*.txt
cache_output.txt
cache-result.txt
route_backup.txt

# playwright artifacts
/test-results/
/playwright-report/

# visual-validator frame-dump runs (THE EYE) — working artifacts, never repo content
# (visual_baselines/ IS tracked — those are the approved regression baselines)
/.visual_runs/
/.founder_runs/

# numeric-gate runs (THE CALCULATOR) — harvested readings + check results
/.calc_runs/

# large regeneratable data (extracted from PDFs / generated JSONL)
/ncert/
ncert_chunks.jsonl
ncert_class10_chunks.json
dc_pandey_chunks.jsonl
dcp_em_chunks.jsonl
dcp_optics_chunks.jsonl
openstax_cp_chunks.jsonl

# OCR / LLM output caches (per-image / per-page JSON, gitignored, skip-on-rerun)
.cache/

# tesseract OCR data (auto-downloaded by visual validator on first run; ~10MB binary)
eng.traineddata
*.traineddata

# debug probe + raw API dump artifacts (per-session investigation, never persistent)
.friction-probe.json
deep-dive-raw-*.txt

# copyrighted source textbooks — never commit
/pdfs/

# python virtualenvs
venv/
venv*/
*/venv/
*/venv*/
__pycache__/
*.pyc

# Static review-site build artifact (build:review) — not tracked
review-site/

# Quick Learn chat/interaction logs (quicklearn_chat_server.ts) — local only
.quicklearn_logs/

# Local Netlify folder
.netlify
review-site-archive/

# Windows redirect-typo artifact (a "> nul" in Git Bash creates a real file)
nul

# scratch bring-up artifacts (generated HTML/PNG probes)
/.scratch_nlb/
/.scratch_nlb_repeat/
/.scratch_nlb_spring/
/.scratch_nlb_seams/
/.scratch_nlb_mass/
/.scratch_nlb_wall/

# Answer-book build artifact (build:answers) — not tracked
/answer-book/dist/

# Vidi local dev logs (shakedown transcripts, usage JSONL, dev-server log)
.answerbook_logs/

# rbr probe outputs (desk A, rotmech): assembled sim HTML + captures. The
# PROBES themselves are tracked under src/scripts/_scratch_rbr_*.ts — only
# their generated artifacts are ignored.
/.scratch_rbr_formula/
/.scratch_rbr_e4/
/.scratch_rbr_e5/
/.scratch_rbr_narr/
/.scratch_rbr_theta/
/.scratch_rbr_a28/

# Quick Learn generated output — regenerable, never tracked:
#   ql-deploy/site/   <- node ql-deploy/prepare_site.mjs (from review-site/)
#   website/learn/    <- npm run build:quicklearn:public
ql-deploy/site/
ql-deploy/.wrangler/
website/learn/
answer-book/content/
answer-book/dist-gated/
# Per-stream book builds: --stream=mpc → answer-book/dist-mpc/ (index.html +
# og.png), and any stream added later. Same rule as dist/ and dist-gated/ —
# a ~6 MB generated artifact, rebuilt by npm run build:answers:<stream>.
answer-book/dist-*/

# Scratch output of the answer-book authoring tools (measure_wrap, render_figures):
# a wrap report and a rendered figure gallery, both regenerated on every run.
answer-book/tools/out/
smoke.pid

# local smoke-run logs (detached Playwright runs write here)
.smoke_*.log
