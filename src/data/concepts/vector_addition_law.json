  "real_world_anchor": {
    "primary": "A map app that shows two different numbers for the same two-leg walk: the route distance the trip-meter adds up (7 km), and the straight-line distance 'as the crow flies' (5 km).",
    "secondary": "Two tugboats towing one ship at an angle. The ship surges along the diagonal between the two tow ropes, not along the arithmetic sum of the two rope tensions."
  },
  "physics_engine_config": {
    "variables": {
      "a": {
        "name": "Length of leg A (walked/drawn first, reference direction)",
        "unit": "km",
        "min": 1,
        "max": 6,
        "step": 0.5,
        "default": 3
      },
      "b": {
        "name": "Length of leg B (carried tip-to-tail onto A)",
        "unit": "km",
        "min": 1,
        "max": 6,
        "step": 0.5,
        "default": 4
      },
      "theta": {
        "name": "Angle between vector A and vector B (both measured from a common tail)",
        "unit": "deg",
        "min": 0,
        "max": 180,
        "step": 5,
        "default": 90
      },
      "walk_phase": {
        "name": "STATE_1-only choreography driver: 0=start, 1=corner (end of leg A), 2=finish (end of leg B). Internal only, never a UI control.",
        "unit": "leg",
        "min": 0,
        "max": 2,
        "default": 0
      }
    },
    "formulas": {
      "triangle_law": "R = sqrt(a^2 + b^2 + 2 a b cos(theta))",
      "range_inequality": "|a - b| <= R <= a + b",
      "scalar_sum": "sum_scalar = a + b, always, regardless of theta"
    },
    "computed_outputs": {
      "R_mag": {
        "formula": "sqrt(a*a + b*b + 2*a*b*cos(theta*PI/180))"
      },
      "R_dir_deg": {
        "formula": "atan2(b*sin(theta*PI/180), a + b*cos(theta*PI/180)) * 180/PI"
      },
      "sum_scalar": {
        "formula": "a + b"
      },
      "P1_x": {
        "formula": "a"
      },
      "P1_y": {
        "formula": "0"
      },
      "P2_x": {
        "formula": "a + b*cos(theta*PI/180)"
      },
      "P2_y": {
        "formula": "b*sin(theta*PI/180)"
      },
      "trip_meter": {
        "formula": "a*min(walk_phase,1) + b*max(walk_phase-1,0)"
      },
      "walk_x": {
        "formula": "min(walk_phase,1)*a + max(walk_phase-1,0)*b*cos(theta*PI/180)"
      },
      "walk_y": {
        "formula": "max(walk_phase-1,0)*b*sin(theta*PI/180)"
      }
    },
    "derived_fields_declared": [
      "R_mag",
      "R_dir_deg",
      "sum_scalar",
      "P1_x",
      "P1_y",
      "P2_x",
      "P2_y",
      "trip_meter",
      "walk_x",
      "walk_y"
    ],
    "constraints": [
      "R never equals a+b except exactly at theta=0; |a-b| <= R <= a+b always",
      "theta is the angle BETWEEN vector A and vector B (both measured from a common tail), matching the physics_engine_config used across the vectors track",
      "walk_phase drives ONLY the STATE_1 trip-meter/locus choreography; it is never a live slider and is not read anywhere else",
      "R_dir_deg feeds direction_deg_expr on the R arrow/angle only — this concept never surfaces an alpha=tan^-1(...) direction formula (deferred to the future sibling resultant_direction)",
      "zero-length R (degenerate a=b, theta=180, reachable in STATE_5) is correct physics and renders as a genuine vanishing arrow, never clamped"
    ]
  },
