  "real_world_anchor": {
    "primary": "A delivery drone is handed the same two-leg route a van drives — one leg, a turn, a second leg. The drone flies the straight line instead, but knowing the distance isn't enough: it cannot launch until it knows the compass bearing of its nose, measured from the first leg's direction. That bearing is exactly alpha.",
    "secondary": "Two tugboats tow one ship at an angle. The ship surges along a diagonal, but the helmsman needs to know which diagonal — it swings toward whichever tug pulls harder."
  },
  "physics_engine_config": {
    "variables": {
      "a": {
        "name": "Length of vector A (reference direction, drone leg 1 / tugboat 1)",
        "unit": "km",
        "min": 1,
        "max": 6,
        "step": 0.5,
        "default": 3
      },
      "b": {
        "name": "Length of vector B (carried tip-to-tail onto A, per vector_addition_law)",
        "unit": "km",
        "min": 1,
        "max": 6,
        "step": 0.5,
        "default": 4
      },
      "theta": {
        "name": "Angle between vector A and vector B (both measured from a common tail)",
        "unit": "deg",
        "min": 0,
        "max": 180,
        "step": 5,
        "default": 60
      },
      "probe_heading_deg": {
        "name": "STATE_1-only choreography driver: candidate heading of the sweeping ghost arrow during sweep-and-lock. Internal only, never a UI control.",
        "unit": "deg",
        "min": -15,
        "max": 180,
        "default": 0
      },
      "tracer_t": {
        "name": "STATE_3-only choreography driver: 0=tracer at start, 0.5=tracer at foot of perpendicular (base fully traced), 1=tracer at R's tip (riser fully traced). Internal only, never a UI control.",
        "unit": "fraction",
        "min": 0,
        "max": 1,
        "default": 0
      }
    },
    "formulas": {
      "shadow": "b * cos(theta * PI / 180)",
      "riser": "b * sin(theta * PI / 180)",
      "base": "a + b * cos(theta * PI / 180)",
      "tan_alpha_formula": "riser / base — i.e. b*sin(theta*PI/180) / (a + b*cos(theta*PI/180))",
      "alpha_formula": "atan2(riser, base) * 180 / PI — quadrant-safe; never atan(riser/base)"
    },
    "computed_outputs": {
      "shadow": { "formula": "b * cos(theta * PI / 180)" },
      "riser": { "formula": "b * sin(theta * PI / 180)" },
      "base": { "formula": "a + b * cos(theta * PI / 180)" },
      "R_mag": { "formula": "sqrt(a*a + b*b + 2*a*b*cos(theta * PI / 180))" },
      "alpha_deg": { "formula": "atan2(b*sin(theta * PI / 180), a + b*cos(theta * PI / 180)) * 180 / PI" },
      "tan_alpha": { "formula": "(b*sin(theta * PI / 180)) / (a + b*cos(theta * PI / 180))" },
      "P1_x": { "formula": "a" },
      "P1_y": { "formula": "0" },
      "P2_x": { "formula": "a + b*cos(theta * PI / 180)" },
      "P2_y": { "formula": "b*sin(theta * PI / 180)" }
    },
    "derived_fields_declared": [
      "shadow", "riser", "base", "R_mag", "alpha_deg", "tan_alpha", "P1_x", "P1_y", "P2_x", "P2_y"
    ],
    "constraints": [
      "alpha_deg IS the parent's R_dir_deg formula, renamed/foregrounded — atan2(b*sin(theta*PI/180), a+b*cos(theta*PI/180))*180/PI; this concept cashes out the formula vector_addition_law's own constraint block explicitly deferred here",
      "alpha_deg MUST use atan2(riser, base), never atan(riser/base) — riser = b*sin(theta*PI/180) >= 0 for all theta in [0deg,180deg], so atan2 alone returns a continuous, correctly-signed result over the full physical domain with no extra branch/correction needed",
      "0 <= alpha_deg <= theta for all theta in [0deg,180deg]; strict alpha_deg < theta on the open interval (0deg,180deg) whenever a>0,b>0; equality only at the two boundary points — R never leads theta, it always trails",
      "alpha_deg = theta/2 exactly if and only if a = b (any theta in (0deg,180deg)); this is the resultant-bisects-the-angle identity, verified numerically at a=b=3, theta=60deg -> alpha=30.000deg",
      "base can go negative (theta past arccos(-a/b)); this is correct physics (the shadow of B points backward past A's tail) and must render as a genuine sign flip, never clamped to zero",
      "R_mag is identical in formula to vector_addition_law's R_mag — do not re-derive, do not touch vector_addition_law.json (its own constraint line already defers this formula here)"
    ]
  },
