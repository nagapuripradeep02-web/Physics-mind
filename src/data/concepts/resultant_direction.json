  "assessment": {
    "mastery_definition": "A student who can name which vector alpha is measured from, correctly decompose B into along/across parts, compute tan alpha from the full base (not just A), state that R leans toward the bigger vector, and read off the theta=90 and R-perpendicular-to-A special cases has mastered this concept.",
    "questions": [
      {
        "q_id": "q1",
        "stem": "The direction angle alpha of the resultant R is measured starting from which vector?",
        "options": {
          "A": "From vector A",
          "B": "From vector B",
          "C": "From the bisector of theta",
          "D": "From true north, independent of A or B"
        },
        "correct": "A",
        "distractor_misconceptions": {
          "B": "confuses alpha with the angle measured from B, the OTHER leg, not A",
          "C": "imports the bisector belief early — assumes symmetric splitting before it's even discussed",
          "D": "treats alpha as an absolute compass bearing unrelated to A's own direction — but the whole point of the drone hook is that the bearing is relative to the first leg"
        },
        "tested_idea": "alpha_reference_vector",
        "teaches_state": "STATE_1",
        "difficulty": "core",
        "parallel_form_stem": "A pilot reports a bearing measured from her first flight leg. Which leg defines the zero of that bearing?"
      },
      {
        "q_id": "q2",
        "stem": "The component of vector B that lies ALONG vector A is:",
        "options": {
          "A": "B cos theta",
          "B": "B sin theta",
          "C": "B tan theta",
          "D": "Just B (the whole vector lies along A)"
        },
        "correct": "A",
        "distractor_misconceptions": {
          "B": "swaps sine and cosine — assigns the trig function of the OPPOSITE (across) side to the adjacent (along) side",
          "C": "guesses a ratio-based formula, mixing up the tangent identity with a simple projection",
          "D": "skips decomposition entirely — assumes B contributes its full length along A regardless of the angle between them"
        },
        "tested_idea": "component_along_vs_across",
        "teaches_state": "STATE_2",
        "difficulty": "core",
        "parallel_form_stem": "A rope pulls at an angle to a track. What fraction of its pull acts along the track's own direction?"
      },
      {
        "q_id": "q3",
        "stem": "For A = 3 km, B = 4 km, theta = 60 degrees, what is tan alpha?",
        "options": {
          "A": "0.69",
          "B": "1.15",
          "C": "1.33",
          "D": "0.40"
        },
        "correct": "A",
        "distractor_misconceptions": {
          "B": "the classic denominator error — uses A alone (3) as the adjacent side instead of A + B cos theta (5.0), this concept's PRIMARY misconception",
          "C": "misapplies the theta=90 special case (tan alpha = B/A) to a general angle where it does not hold",
          "D": "swaps sine and cosine in the numerator — uses B cos theta instead of B sin theta as the across term"
        },
        "tested_idea": "tangent_denominator_full_base",
        "teaches_state": "STATE_3",
        "difficulty": "core",
        "parallel_form_stem": "For A = 5 km, B = 5 km, theta = 60 degrees, what is tan alpha (to 2 dp)?"
      },
      {
        "q_id": "q4",
        "stem": "If A and B are unequal in length, does the resultant R bisect the angle theta between them?",
        "options": {
          "A": "No — R leans toward the bigger vector; it bisects only when A equals B",
          "B": "Yes, always, regardless of the two lengths",
          "C": "No — R always leans toward the SMALLER vector",
          "D": "R bisects theta only when theta equals 90 degrees"
        },
        "correct": "A",
        "distractor_misconceptions": {
          "B": "the classic bisector misconception — generalizes from the equal-vectors textbook picture to every case",
          "C": "gets the lean direction backwards — R leans toward the bigger vector, not away from it",
          "D": "confuses the bisection condition (A = B) with the unrelated theta = 90 degree landmark from the angle-sweep state"
        },
        "tested_idea": "resultant_lean_not_bisect",
        "teaches_state": "STATE_4",
        "difficulty": "core",
        "parallel_form_stem": "Two tow ropes pull a barge, one twice as strong as the other. Does the barge surge exactly down the middle?"
      },
      {
        "q_id": "q5",
        "stem": "At theta = 90 degrees (A = 3 km, B = 4 km), what is tan alpha?",
        "options": {
          "A": "tan alpha = B/A = 4/3, about 1.33",
          "B": "tan alpha = A/B = 3/4, about 0.75",
          "C": "tan alpha = 1, since alpha equals theta at 90 degrees",
          "D": "tan alpha is undefined, because both A and B cos theta vanish at 90 degrees"
        },
        "correct": "A",
        "distractor_misconceptions": {
          "B": "inverts the ratio — computes A/B instead of B/A",
          "C": "confuses alpha with theta itself — assumes the resultant's angle equals the angle between the vectors",
          "D": "confuses this state's OTHER landmark (the base vanishing at theta of about 138.6 degrees) with theta = 90 degrees, wrongly believing the base vanishes here too"
        },
        "tested_idea": "theta_90_special_case",
        "teaches_state": "STATE_5",
        "difficulty": "stretch",
        "parallel_form_stem": "For A = 6 km, B = 8 km, theta = 90 degrees, what is tan alpha?"
      },
      {
        "q_id": "q6",
        "stem": "If R is exactly perpendicular to A (A = 3 km, B = 4 km), what is cos theta?",
        "options": {
          "A": "cos theta = -A/B = -0.75",
          "B": "cos theta = -B/A",
          "C": "cos theta = +A/B = +0.75",
          "D": "cos theta = 0, since perpendicular means a 90 degree angle"
        },
        "correct": "A",
        "distractor_misconceptions": {
          "B": "misapplies the maximum-lean-angle formula (cos theta = -B/A, only valid when B is smaller than A) to this different perpendicular-R condition",
          "C": "drops the negative sign — forgets the shadow must point backward to exactly cancel A",
          "D": "confuses 'R is perpendicular to A' with 'theta itself is 90 degrees' — two entirely different angles"
        },
        "tested_idea": "perpendicular_condition_base_zero",
        "teaches_state": "STATE_5",
        "difficulty": "stretch",
        "parallel_form_stem": "For A = 4 km, B = 5 km, what value of cos theta makes R exactly perpendicular to A?"
      }
    ]
  },
