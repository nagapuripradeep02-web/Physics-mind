  "real_world_anchor": {
    "primary": "A trailhead signpost that reads 'Lake — 5 km.' A hiker leaves camp along one heading and could just as easily have left along the opposite heading; the signpost's single number never tells you which way anyone ended up.",
    "secondary": "Two people pulling a stuck cart together. Pulling in the same direction adds their effort fully; pulling at an angle adds less. The size of the combined pull depends on the angle between the two pulls, not just on the two numbers alone.",
    "tertiary": "A hanging luggage scale reading the same total no matter how the loaded bags are turned, reordered, or spun on the hook — mass just adds, with no geometry involved at all."
  },
  "physics_engine_config": {
    "variables": {
      "a": {
        "name": "Length of leg A (walked East)",
        "unit": "km",
        "min": 1,
        "max": 6,
        "default": 3
      },
      "b": {
        "name": "Length of leg B (walked after the turn)",
        "unit": "km",
        "min": 1,
        "max": 6,
        "default": 4
      },
      "theta": {
        "name": "Turn angle between leg A and leg B",
        "unit": "deg",
        "min": 0,
        "max": 180,
        "default": 90
      },
      "d_hook": {
        "name": "Hook vector length (constant, S1 only)",
        "unit": "km",
        "constant": 5
      },
      "phi_hook": {
        "name": "Hook vector heading (narrative only, no live control)",
        "unit": "deg",
        "default": 0
      },
      "m1": {
        "name": "Mass of the first bag on the scale",
        "unit": "kg",
        "constant": 3
      },
      "m2": {
        "name": "Mass of the second bag on the scale",
        "unit": "kg",
        "constant": 4
      },
      "m_pack": {
        "name": "Total pack mass on the scale (S2)",
        "unit": "kg",
        "constant": 8
      },
      "psi_pointer": {
        "name": "Decorative pointer angle — does not affect the reading",
        "unit": "deg",
        "default": 0
      }
    },
    "formulas": {
      "triangle_law": "R = sqrt(a^2 + b^2 + 2 a b cos(theta))",
      "direction_of_resultant": "tan(alpha) = b sin(theta) / (a + b cos(theta))",
      "scalar_addition": "mass sum = m1 + m2, always, regardless of arrangement or angle"
    },
    "computed_outputs": {
      "R_mag": {
        "formula": "sqrt(a*a + b*b + 2*a*b*cos(theta*PI/180))"
      },
      "R_dir_deg": {
        "formula": "atan2(b*sin(theta*PI/180), a + b*cos(theta*PI/180)) * 180/PI"
      },
      "sum_scalar": {
        "formula": "a + b"
      },
      "mass_sum": {
        "formula": "m1 + m2"
      },
      "P1_x": {
        "formula": "a"
      },
      "P1_y": {
        "formula": "0"
      },
      "P2_x": {
        "formula": "a + b*cos(theta*PI/180)"
      },
      "P2_y": {
        "formula": "b*sin(theta*PI/180)"
      },
      "hook_x": {
        "formula": "d_hook*cos(phi_hook*PI/180)"
      },
      "hook_y": {
        "formula": "d_hook*sin(phi_hook*PI/180)"
      }
    },
    "derived_fields_declared": [
      "R_mag",
      "R_dir_deg",
      "sum_scalar",
      "mass_sum",
      "P1_x",
      "P1_y",
      "P2_x",
      "P2_y",
      "hook_x",
      "hook_y"
    ],
    "constraints": [
      "R never equals a+b except exactly at theta=0; |a-b| <= R <= a+b always",
      "mass addition (m1+m2) is scalar arithmetic, always, independent of any spatial arrangement",
      "theta is the angle BETWEEN vector A and vector B (heading turn at the walk vertex), not the interior path corner angle (which is 180-theta)",
      "d_hook/phi_hook (S1) are independent of a/b/theta — a standalone single-vector hook",
      "psi_pointer (S2) drives nothing physical — proves direction is irrelevant to a scalar reading",
      "S5's hanging scale stays non-reactive to a/b/theta — needle fixed at m1+m2=7 always, never wired to the vector sliders"
    ]
  },
