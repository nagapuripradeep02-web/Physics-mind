 "question": {
  "text": "An object possesses an initial velocity v₀ = 10 ms⁻¹ and is subjected to a deceleration of magnitude 0.2v², where v represents its instantaneous velocity. What will be the velocity of the object at t = 2 s?",
  "options": {
   "1": "+ 2 ms⁻¹",
   "2": "+ 4 ms⁻¹",
   "3": "− 2 ms⁻¹",
   "4": "+ 6 ms⁻¹"
  },
  "parts": null,
  "conditions": [
   "initial velocity v₀ = 10 ms⁻¹",
   "retardation = 0.2v²",
   "time t = 2 s"
  ],
  "figure": null
 },
 "solution": {
  "approach": "Write the retardation as dv/dt = −0.2v² and separate the variables to find v as a function of t.",
  "steps": [
   {
    "text": "Write the equation of motion using the given retardation.",
    "equation": "dv/dt = −0.2v²"
   },
   {
    "text": "Separate the variables and integrate from v₀ = 10 at t = 0 to v at time t.",
    "equation": "∫ dv/v² = −0.2 ∫ dt → 1/v₀ − 1/v = −0.2t"
   },
   {
    "text": "Rearrange to express 1/v.",
    "equation": "1/v = 1/v₀ + 0.2t"
   },
   {
    "text": "Substitute v₀ = 10 and t = 2 s.",
    "equation": "1/v = 1/10 + 0.2(2) = 0.1 + 0.4 = 0.5"
   },
   {
    "text": "Take the reciprocal to find the velocity after 2 s.",
    "equation": "v = 1/0.5 = 2 ms⁻¹"
   }
  ],
  "final_answer": {
   "option": 1,
   "value": "+2 ms⁻¹"
  },
