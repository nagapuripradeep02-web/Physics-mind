    "steps": [
      {
        "id": "s1_statement",
        "kind": "text",
        "label": "State the law",
        "marks": 2,
        "mark_note": "Statement",
        "margin_note": "Write the whole statement. The two marks are for the words alone.",
        "lines": [
          {
            "text": "Statement:",
            "style": "heading"
          },
          "If two vectors acting at a point are represented",
          "in magnitude and direction by the two adjacent",
          "sides of a parallelogram drawn from that point,",
          "then their resultant is represented in magnitude",
          "and direction by the diagonal of the parallelogram",
          "drawn from the same point."
        ]
      },
      {
