        "kind": "diagram",
        "label": "Draw the figure",
        "marks": 1,
        "mark_note": "Figure",
        "margin_note": "Label every point: O, A, B, C, D. Mark the angles θ and α and the sides P, Q, R. One mark is for a complete, labelled figure.",
        "figure": {
