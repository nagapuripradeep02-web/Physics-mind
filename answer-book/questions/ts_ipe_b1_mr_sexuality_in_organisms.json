    "steps": [
      {
        "id": "s1_bisexual_unisexual",
        "kind": "text",
        "label": "Bisexual vs unisexual",
        "marks": 1,
        "mark_note": "The two conditions",
        "lines": [
          "Plants that bear both male and female",
          "reproductive structures on the same",
          "plant are bisexual plants; plants that",
          "bear them on different plants are",
          "unisexual plants."
        ],
        "why": "The whole account is one contrast — both sexes together, or on separate individuals — described at three levels: fungi, plants, and flowers.",
        "common_mistakes": [
          "Writing bisexual = two plants — bisexual means BOTH organs on ONE plant."
        ],
        "memory_tip": "Bi = both organs in one body; uni = one sex per body.",
        "margin_note": "Open with the two definitions in one sentence pair."
      },
      {
        "id": "s2_bisexual_terms",
        "kind": "text",
        "label": "Homothallic and monoecious",
        "marks": 1,
        "mark_note": "Bisexual terms",
        "lines": [
          "For the bisexual condition:",
          "Homothallic — male and female sex organs",
          "on the same thallus (fungi).",
          "Ex: Rhizopus sexualis.",
          "Monoecious — both sex organs on the same",
          "plant. Ex: Chara, maize, cucurbits,",
          "coconut."
        ],
        "why": "Two names for one condition at two body levels: homothallic for a thallus (fungi), monoecious for a plant body.",
        "common_mistakes": [
          "Pairing homothallic with dioecious — homothallic goes with MONOecious (both mean bisexual).",
          "Writing Rhizopus stolonifer here — sexualis is the homothallic species; stolonifer is heterothallic."
        ],
        "memory_tip": "Homo = same thallus, mono = one plant — both mean the two organs occur on one body.",
        "margin_note": "Both terms + one example each."
      },
      {
        "id": "s3_unisexual_terms",
        "kind": "text",
        "label": "Heterothallic and dioecious",
        "marks": 1,
        "mark_note": "Unisexual terms",
        "lines": [
          "For the unisexual condition:",
          "Heterothallic — the two sex organs on",
          "different thalli of the same species.",
          "Ex: Rhizopus stolonifer.",
          "Dioecious — male and female organs on",
          "separate plants. Ex: Marchantia, papaya,",
          "date palm.",
          "A unisexual male flower (only stamens)",
          "is a staminate flower; a female flower",
          "(only pistils) is a pistillate flower.",
          "Ex: papaya."
        ],
        "why": "The unisexual side mirrors the bisexual side term for term, and the flower-level names (staminate, pistillate) complete the account in flowering plants.",
        "common_mistakes": [
          "Swapping staminate and pistillate — the staminate flower carries STAMENS (male).",
          "Writing papaya as monoecious — papaya is the standard dioecious example."
        ],
        "memory_tip": "Each flower is named for the organ it keeps: staminate = stamens only (male); pistillate = pistils only (female).",
        "margin_note": "Mirror the previous step: two terms, examples, then the two flower names."
