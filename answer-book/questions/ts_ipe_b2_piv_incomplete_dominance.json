    "steps": [
      {
        "id": "s1_what",
        "kind": "text",
        "label": "What incomplete dominance is",
        "marks": 1,
        "mark_note": "Definition",
        "margin_note": "Definition with the word intermediate. This is the contrast with co-dominance.",
        "lines": [
          "INCOMPLETE DOMINANCE is the condition in",
          "which NEITHER allele is completely dominant nor",
          "completely recessive.",
          "The heterozygote shows an INTERMEDIATE",
          "character, different from both parents."
        ],
        "why": "Neither allele fully masking the other is what produces a third appearance that neither parent had.",
        "common_mistakes": [
          "Saying both characters appear. That is CO-DOMINANCE; here a NEW intermediate appears.",
          "Saying one allele is recessive. Neither is completely dominant or recessive."
        ],
        "memory_tip": "A new middle character, not both characters."
      },
      {
        "id": "s2_example",
        "kind": "text",
        "label": "The snapdragon example",
        "marks": 1,
        "mark_note": "Example",
        "margin_note": "Name the plant, the cross, and the F1 colour. Five lines.",
        "lines": [
          "Example: flower colour in the DOG FLOWER",
          "(snapdragon, Antirrhinum).",
          "A homozygous RED flowered plant (RR) is crossed",
          "with a homozygous WHITE flowered plant (rr).",
          "The F₁ (Rr) is PINK — a colour neither parent",
          "had."
        ],
        "why": "Pink is not a mixture of red and white flowers but a colour of its own, produced because one R allele makes only half the pigment.",
        "common_mistakes": [
          "Naming the ABO blood groups. That is CO-DOMINANCE.",
          "Saying the F1 is red. The F1 of this cross is PINK."
        ],
        "memory_tip": "Red and white parents, pink children."
      },
      {
        "id": "s3_f2",
        "kind": "text",
        "label": "The F2 generation",
        "marks": 1,
        "mark_note": "F2",
        "margin_note": "All three classes with genotype and colour. Five lines.",
        "lines": [
          "Selfing the F₁ pink plants gives:",
          "1 RR  RED",
          "2 Rr  PINK",
          "1 rr  WHITE",
          "So the F₂ ratio is 1 : 2 : 1."
        ],
        "why": "The genotypes come out in the ordinary Mendelian proportions; only the way they look has changed.",
        "common_mistakes": [
          "Giving 3:1. The phenotypic ratio here is 1:2:1.",
          "Saying the pink disappears in F2. Half the F2 plants are pink."
        ],
        "memory_tip": "Same square, three visible classes instead of two."
      },
      {
        "id": "s4_ratios",
        "kind": "boxed_final",
        "label": "Why the ratios change",
        "marks": 1,
        "mark_note": "Ratios",
        "margin_note": "Both ratios, and the reason. This is the mark that separates a full answer.",
        "lines": [
          {
            "text": "Genotypic ratio unchanged at 1 : 2 : 1;",
            "style": "boxed"
          },
          {
            "text": "phenotypic ratio changes from 3 : 1 to 1 : 2 : 1",
            "style": "boxed"
          },
          "The GENOTYPIC ratio is exactly as in Mendel's",
          "monohybrid cross: 1 : 2 : 1.",
          "The PHENOTYPIC ratio has changed from 3 : 1 to",
          "1 : 2 : 1.",
          "This is because R is incompletely dominant over",
          "r, so Rr (pink) can be told apart from RR (red)."
        ],
        "why": "Mendel's laws still hold — the alleles segregate exactly as he said — and only the visibility of the heterozygote has changed.",
        "common_mistakes": [
          "Saying incomplete dominance breaks Mendel's laws. The GENOTYPIC ratio is unchanged.",
          "Giving one ratio only. The whole point is that the two ratios now differ from 3:1."
        ],
        "memory_tip": "The genes behave exactly as Mendel said; only the heterozygote now shows."
      },
