    "steps": [
      {
        "id": "s1_what",
        "kind": "text",
        "label": "What antibodies are",
        "marks": 1,
        "mark_note": "What they are",
        "why": "Each antibody fits one antigen only, which is why the body needs so many different ones.",
        "common_mistakes": [
          "Saying T cells make antibodies. B lymphocytes do.",
          "Writing that one antibody works against any germ."
        ],
        "memory_tip": "Antibody and antigen fit like a lock and key.",
        "margin_note": "Who makes them and how specific they are.",
        "lines": [
          "Antibodies, or immunoglobulins, are",
          "produced by B lymphocytes when pathogens",
          "enter the body.",
          "Antibodies are antigen specific."
        ]
      },
      {
        "id": "s2_free_surface",
        "kind": "text",
        "label": "Free and surface antibodies",
        "marks": 1,
        "mark_note": "Two types",
        "why": "An antibody floating in the blood can reach a germ anywhere, while one fixed to a cell turns that cell into a detector.",
        "common_mistakes": [
          "Naming five types here. The five classes come later; here there are two.",
          "Leaving out where each is found."
        ],
        "memory_tip": "Free ones travel in blood; surface ones stay on the cell.",
        "margin_note": "Two types, and where each is found.",
        "lines": [
          "By mobility there are two types of",
          "antibodies: free antibodies and surface",
          "antibodies.",
          "Circulating or free antibodies are present",
          "in blood and lymph.",
          "Surface antibodies are present on the",
          "surface of B cells and memory cells."
        ]
      },
      {
        "id": "s3_structure",
        "kind": "text",
        "label": "Structure and classes",
        "marks": 1,
        "mark_note": "Structure",
        "why": "Two arms means one antibody can hold two antigens at once, which is how it clumps germs together.",
        "common_mistakes": [
          "Giving two chains. There are four: two heavy and two light.",
          "Swapping the ends. The antigen binds at the Fab end."
        ],
        "memory_tip": "H₂L₂: two heavy, two light. Fab holds the antigen, Fc holds the cell.",
        "margin_note": "Write H₂L₂ and name both ends.",
        "lines": [
          "An antibody is a Y shaped molecule with",
          "four polypeptide chains: two long identical",
          "heavy chains and two small light chains.",
          {
            "text": "It is written as H₂L₂",
            "style": "eq"
          },
          "The chains are linked by disulfide bonds.",
          "The antigen attaches at the Fab end. The",
          "Fc end may attach to B cells.",
          "By structure there are five classes: IgD,",
          "IgE, IgG, IgA and IgM."
        ]
      },
