    "steps": [
      {
        "id": "s1_what",
        "kind": "text",
        "label": "A free moving joint",
        "marks": 1,
        "mark_note": "What it is",
        "why": "A joint that has to move freely needs a sealed space with fluid in it, and that space is what the capsule encloses.",
        "common_mistakes": [
          "Calling it a fixed joint. Synovial joints are freely movable.",
          "Giving one layer to the capsule. It is double layered."
        ],
        "memory_tip": "Free movement needs a fluid-filled bag: that bag is the synovial capsule.",
        "margin_note": "Two lines. Name the capsule at once.",
        "lines": [
          "A synovial joint is a freely moving joint.",
          "It has a double layered synovial capsule",
          "around it."
        ]
      },
      {
        "id": "s2_outer",
        "kind": "text",
        "label": "The outer layer",
        "marks": 1,
        "mark_note": "Outer layer",
        "why": "The outer layer is continuous with the covering of the bone itself, so the capsule is anchored and the bones cannot be pulled apart.",
        "common_mistakes": [
          "Saying the outer layer secretes the fluid. The inner layer does.",
          "Leaving out the periosteum."
        ],
        "memory_tip": "Outer layer is tough collagen: it holds the joint together.",
        "margin_note": "Say what it is made of and what it does.",
        "lines": [
          "The outer layer is a dense collagen layer.",
          "It is continuous with the periosteum of",
          "the bone.",
          "It prevents dislocation of the joint."
        ]
      },
      {
        "id": "s3_inner",
        "kind": "text",
        "label": "The inner layer and the fluid",
        "marks": 1,
        "mark_note": "Inner layer and fluid",
        "why": "Hyaluronic acid makes the fluid thick and slippery, so the two cartilage surfaces slide instead of grinding.",
        "common_mistakes": [
          "Leaving out hyaluronic acid. It is the marked name.",
          "Writing that the fluid nourishes the bone. Its named job here is lubrication."
        ],
        "memory_tip": "Inner layer makes the oil; hyaluronic acid makes it thick.",
        "margin_note": "Finish with the list of synovial joints. It is an easy extra line.",
        "lines": [
          "The inner layer is formed of areolar tissue",
          "and elastic fibres.",
          "It secretes a viscous synovial fluid which",
          "contains hyaluronic acid.",
          "This fluid acts as a lubricant and lets the",
          "joint move freely.",
          "Ball and socket, hinge, pivot, gliding,",
          "condyloid and saddle joints are all",
          "synovial joints."
        ]
      },
