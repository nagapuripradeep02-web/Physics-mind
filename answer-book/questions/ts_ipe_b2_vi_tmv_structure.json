    "steps": [
      {
        "id": "s1_what",
        "kind": "text",
        "label": "What TMV is",
        "marks": 1,
        "mark_note": "What it is",
        "margin_note": "Expansion, host, symptom, nucleic acid type. Five lines.",
        "lines": [
          "TMV stands for TOBACCO MOSAIC VIRUS.",
          "It is a plant virus that infects tobacco plants",
          "and causes a mosaic pattern of light and dark",
          "patches on the leaves.",
          "It is a single stranded RNA virus.",
          "It was the FIRST virus ever discovered."
        ],
        "why": "TMV was the first virus isolated and the first whose structure was worked out, which is why it is the standard example in every syllabus.",
        "common_mistakes": [
          "Saying TMV is a DNA virus. Its genetic material is single stranded RNA.",
          "Saying it infects animals. TMV is a PLANT virus."
        ],
        "memory_tip": "Tobacco, mosaic pattern, RNA."
      },
      {
        "id": "s2_size",
        "kind": "text",
        "label": "Shape and size",
        "marks": 1,
        "mark_note": "Shape, size",
        "margin_note": "Shape and both numbers. The molecular weight is a bonus.",
        "lines": [
          "TMV is ROD SHAPED.",
          "It is about 300 nm long and 18 nm in diameter.",
          "Its molecular weight is about 39 million",
          "daltons (39 x 10 to the power 6)."
        ],
        "why": "The rod shape follows from the helical arrangement of its capsomeres, so shape and internal structure are the same fact described twice.",
        "common_mistakes": [
          "Calling TMV spherical. It is ROD shaped.",
          "Swapping the two dimensions. 300 nm is the LENGTH; 18 nm is the diameter."
        ],
        "memory_tip": "Three hundred long, eighteen across: a long thin rod."
      },
      {
        "id": "s3_capsid",
        "kind": "text",
        "label": "The capsid",
        "marks": 1,
        "mark_note": "Capsid",
        "margin_note": "Number, arrangement, core width, subunit size. All four numbers count.",
        "lines": [
          "The capsid is made of 2,130 protein subunits",
          "called CAPSOMERES.",
          "The capsomeres are arranged in a HELICAL manner",
          "around a central hollow core of 4 nm.",
          "Each protein subunit is made of 158 amino",
          "acids."
        ],
        "why": "A helical stack of identical subunits is what makes a rod rather than a sphere, so the arrangement explains the shape given in the step above.",
        "common_mistakes": [
          "Saying the capsomeres are arranged in a sphere. They are HELICAL.",
          "Leaving out the hollow core. The 4 nm channel runs down the middle."
        ],
        "memory_tip": "Two thousand one hundred and thirty bricks, wound in a helix."
      },
      {
        "id": "s4_rna",
        "kind": "boxed_final",
        "label": "The RNA core",
        "marks": 1,
        "mark_note": "RNA",
        "margin_note": "Strandedness, the coil, the nucleotide count, and what is infective.",
        "lines": [
          {
            "text": "One spiral RNA strand, 6500 nucleotides",
            "style": "boxed"
          },
          "Inside the capsid lies a SINGLE STRANDED RNA,",
          "spirally coiled along the hollow core.",
          "It has about 6,500 nucleotides.",
          "The RNA is the infective part: it alone can",
          "infect a tobacco plant."
        ],
        "why": "The RNA follows the same helix as the protein, so the coat and the genome are wound together rather than the genome sitting loose inside.",
        "common_mistakes": [
          "Saying the RNA is double stranded. TMV RNA is SINGLE stranded.",
          "Saying the protein is the infective part. The RNA alone can infect."
        ],
        "memory_tip": "The RNA follows the same spiral as the coat."
      },
