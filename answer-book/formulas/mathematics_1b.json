            "x/a + y/b = 1"
          ]
        },
        {
          "id": "m1b.sl.normal_form",
          "name": "Normal form of a line",
          "text": "x cos α + y sin α = p",
          "match": [
            "x cos α + y sin α = p",
            "the normal form"
          ]
        },
        {
          "id": "m1b.sl.point_distance",
          "name": "Distance from a point to a line",
          "text": "d = |ax₁ + by₁ + c|/√(a² + b²)",
          "match": [
            "|ax₁ + by₁ + c|/√(a² + b²)",
            "|ax_{1} + by_{1} + c|"
          ]
        },
        {
          "id": "m1b.sl.angle",
          "name": "Angle between two lines",
          "text": "tan θ = |(m₁ − m₂)/(1 + m₁m₂)|",
          "match": [
            "tan θ = |(m₁ − m₂)/(1 + m₁m₂)|",
            "the formula for the angle θ between two lines",
            "the formula for the angle between two lines"
          ]
        },
        {
          "id": "m1b.sl.intersection",
          "name": "Point where two lines meet",
          "text": "x/(b₁c₂ − b₂c₁) = y/(c₁a₂ − c₂a₁) = 1/(a₁b₂ − a₂b₁)",
          "match": [
            "the cross-multiplication rule",
