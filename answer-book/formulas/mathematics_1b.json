          ]
        },
        {
          "id": "m1b.sl.parallel_distance",
          "name": "Distance between two parallel lines",
          "text": "d = |c₁ − c₂|/√(a² + b²)",
          "match": [
            "|c₁ − c₂|/√(a² + b²)",
            "distance between the parallel lines"
          ]
        },
        {
          "id": "m1b.sl.point_at_distance",
          "name": "Point at a given distance along a line",
          "text": "(x₁ + r cos θ, y₁ + r sin θ)",
          "match": [
            "(x₁ + r cos θ, y₁ + r sin θ)",
            "a point at distance r from"
          ]
        }
      ]
    },
    {
      "number": 4,
      "formulas": [
        {
          "id": "m1b.psl.pair_through_origin",
          "name": "Pair of lines through the origin",
          "text": "ax² + 2hxy + by² = 0 is a pair of lines when h² ≥ ab",
          "match": [
            "h² ≥ ab",
            "h^{2} \\ge ab"
          ]
        },
        {
          "id": "m1b.psl.angle",
          "name": "Angle between a pair of lines",
