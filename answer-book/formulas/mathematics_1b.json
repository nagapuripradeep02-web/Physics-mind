    {
      "number": 1,
      "formulas": [
        {
          "id": "m1b.loc.distance",
          "name": "Distance between two points",
          "text": "PQ = √((x₂ − x₁)² + (y₂ − y₁)²)",
          "match": [
            "PA² = (x − x₁)² + (y − y₁)²",
            "the distance formula, squared",
            "√((x₂ − x₁)² + (y₂ − y₁)²)"
          ]
        },
        {
          "id": "m1b.loc.right_angle",
          "name": "Right angle at a point",
          "text": "∠APB = 90° means PA² + PB² = AB²",
          "match": [
            "∠APB = 90°",
            "PA² + PB² = AB²"
          ]
        }
      ]
    },
    {
      "number": 2,
      "formulas": [
        {
          "id": "m1b.ta.translation",
          "name": "Translation of axes",
          "text": "x = X + h, y = Y + k",
          "match": [
            "x = X + h",
            "X = x − h"
          ]
        },
        {
          "id": "m1b.ta.rotation",
          "name": "Rotation of axes",
          "text": "x = X cos θ − Y sin θ, y = X sin θ + Y cos θ",
          "match": [
            "x = X cos θ − Y sin θ",
            "y = X sin θ + Y cos θ"
          ]
        },
        {
          "id": "m1b.ta.remove_xy",
          "name": "Angle that removes the xy term",
          "text": "tan 2θ = 2h/(a − b)",
          "match": [
            "tan 2θ = 2h/(a − b)",
            "tan2θ = 2h/(a−b)"
          ]
        }
      ]
    },
    {
      "number": 3,
      "formulas": [
        {
          "id": "m1b.sl.slope_point",
